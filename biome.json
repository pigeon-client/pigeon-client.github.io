{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "apps/desktop/src/**",
      "apps/desktop/scripts/**",
      "apps/desktop/vite.config.ts",
      "apps/desktop/vitest.config.ts",
      "apps/desktop/playwright.config.ts",
      "apps/desktop/postcss.config.js",
      "apps/site/src/**",
      "!apps/site/src/**/*.astro",
      "!apps/site/src/content",
      "apps/site/astro.config.mjs",
      "apps/site/wrangler.jsonc",
      "packages/*/src/**"
    ],
    "ignoreUnknown": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error",
        "useJsxKeyInIterable": "error",
        "noChildrenProp": "warn"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useSingleVarDeclarator": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/features/*/components/*",
                  "@/features/*/hooks/*",
                  "@/features/*/lib/*",
                  "@/features/*/services/*",
                  "@/features/*/store",
                  "@/features/*/ports/*",
                  "@/features/*/oauth/*",
                  "@/features/*/model/*",
                  "@/features/*/*/components/*",
                  "@/features/*/*/hooks/*",
                  "@/features/*/*/lib/*",
                  "@/features/*/*/services/*",
                  "@/features/*/*/store",
                  "@/features/*/*/ports/*",
                  "@/features/*/*/oauth/*",
                  "@/features/*/*/model/*",
                  "@/features/*/types",
                  "@/features/*/*/types",
                  "@/core/*/components/*",
                  "@/core/*/hooks/*",
                  "@/core/*/lib/*",
                  "@/core/*/services/*",
                  "@/core/*/ports/*",
                  "@/core/*/types"
                ],
                "message": "Import from the module's barrel (index.ts) instead of reaching into its internals."
              }
            ]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessConstructor": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "useSimplifiedLogicExpression": "warn"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noImplicitAnyLet": "error",
        "noVar": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["log"] } }
      },
      "a11y": {
        "useButtonType": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/site/src/styles/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
