---
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  SITE_NAME,
  SITE_URL,
  getInstallScriptUrl,
} from "../lib/constants";
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  noindex?: boolean;
  /** SoftwareApplication JSON-LD — landing page only. */
  softwareSchema?: boolean;
  /** Extra classes on <body> (e.g. page-blog). */
  bodyClass?: string;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = "/",
  ogType = "website",
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
  softwareSchema = false,
  bodyClass = "",
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const imageUrl = new URL(ogImage, SITE_URL).href;
const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: DEFAULT_DESCRIPTION,
  url: SITE_URL,
  downloadUrl: getInstallScriptUrl(),
  license: "https://github.com/pigeon-client/pigeon/blob/main/LICENSE",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/pigeon-mark.svg" />
    <link rel="icon" type="image/png" href="/pigeon-mark.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <slot name="head" />

    {softwareSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    )}
  </head>
  <body class:list={[bodyClass || undefined]}>
    <slot />
  </body>
</html>
