---
import SiteLayout from "./SiteLayout.astro";
import { BlogCodeCopy } from "../components/BlogCodeCopy";
import { BlogGetPigeon } from "../components/BlogGetPigeon";
import { SITE_NAME, SITE_URL } from "../lib/constants";
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  canonicalPath: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  title,
  description,
  seoTitle,
  canonicalPath,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt = "",
} = Astro.props;
const pageTitle = seoTitle ?? `${title} | ${SITE_NAME} API Client Blog`;
const imageUrl = heroImage ? new URL(heroImage, SITE_URL).href : undefined;
const origin = Astro.url.origin;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Organization", name: SITE_NAME },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
  mainEntityOfPage: new URL(canonicalPath, SITE_URL).href,
  ...(imageUrl ? { image: [imageUrl] } : {}),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: new URL(canonicalPath, SITE_URL).href,
    },
  ],
};
---

<SiteLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={heroImage}
  bodyClass="page-blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <main class="site-main">
    <article class="blog-post wrap">
      <header class="blog-post-header">
        <p class="blog-kicker"><a href="/blog">Blog</a></p>
        <h1>{title}</h1>
        <p class="blog-meta">
          <time datetime={pubDate.toISOString()}>
            {
              pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </p>
        <p class="blog-dek">{description}</p>
        {
          heroImage && (
            <figure class="blog-hero">
              <img
                src={heroImage}
                alt={heroImageAlt}
                width={1920}
                height={1080}
                decoding="async"
                fetchpriority="high"
              />
            </figure>
          )
        }
      </header>
      <div class="blog-prose">
        <slot />
      </div>
      <BlogGetPigeon client:load origin={origin} />
      <BlogCodeCopy client:load />
    </article>
  </main>
</SiteLayout>
