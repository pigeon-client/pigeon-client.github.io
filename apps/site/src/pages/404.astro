---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page not found · Pigeon"
  description="That page flew away. Head home or check the blog."
  canonicalPath="/404"
  noindex
  bodyClass="page-blog"
>
  <main class="site-main">
    <div class="wrap blog-index">
      <p class="blog-kicker">404</p>
      <h1>Nothing here</h1>
      <p class="blog-dek">
        That URL is gone. Try the <a href="/">home page</a> or the
        <a href="/blog">blog</a>.
      </p>
    </div>
  </main>
</SiteLayout>
