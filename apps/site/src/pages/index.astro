---
import SiteLayout from "../layouts/SiteLayout.astro";
import { HeroSection } from "../components/HeroSection";
import { StatsBand } from "../components/StatsBand";
import { OrganizeSection } from "../components/OrganizeSection";
import { MomentsSection } from "../components/MomentsSection";
import { FeaturesSection } from "../components/FeaturesSection";
import { WhySection } from "../components/WhySection";
import { OpenSourceSection } from "../components/OpenSourceSection";
import DownloadSection from "../components/DownloadSection.astro";
import { ScrollReveal } from "../components/ScrollReveal";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "../lib/constants";
import "../styles/home.css";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is Pigeon a free alternative to Postman?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Pigeon is completely free and open source. There are no paid tiers, no account requirements, and no cloud sync — your data stays on your machine. See trypigeon.dev/postman-alternative for how we differ.",
      },
    },
    {
      "@type": "Question",
      name: "What platforms does Pigeon support?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Pigeon is available for macOS today (Apple Silicon and Intel) — install with one command: curl from trypigeon.dev/install.sh. The installer clears the Gatekeeper quarantine flag so the app opens without warnings.",
      },
    },
    {
      "@type": "Question",
      name: "Can I import my existing requests?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Paste any cURL command into the URL bar or import modal and Pigeon builds the full request — method, headers, auth, and body. You can also import Postman collections and copy any request back out as cURL.",
      },
    },
    {
      "@type": "Question",
      name: "Does Pigeon require an account?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Open the app and send a request. Collections, history, and environments stay on your Mac — no sign-up wall.",
      },
    },
  ],
};
---

<SiteLayout
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  ogImage="/og/home.webp"
  softwareSchema
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>
  <div class="hero-screen">
    <HeroSection client:load />
  </div>
  <main>
    <StatsBand />
    <OrganizeSection />
    <MomentsSection />
    <FeaturesSection client:visible />
    <WhySection />
    <OpenSourceSection />
    <DownloadSection />
  </main>
  <ScrollReveal client:load />
</SiteLayout>
