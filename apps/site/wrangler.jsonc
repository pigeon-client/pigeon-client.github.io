{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trypigeon",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  // Static Astro build lives in R2; Worker serves objects (trypigeon.dev).
  // Custom domain: Cloudflare dashboard → Workers → trypigeon → Custom Domains.
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "trypigeon-site"
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
