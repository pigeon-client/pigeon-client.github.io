# Copy to `.env` / `.env.local` for local desktop builds (never commit secrets).
# Unset or empty disables anonymous analytics.

# Analytics Worker base URL (no trailing slash).
# Production builds default to https://analytics.trypigeon.dev when unset.
# Set empty to disable: VITE_ANALYTICS_API_URL=
# VITE_ANALYTICS_API_URL=https://analytics.trypigeon.dev
# Local Wrangler:
# VITE_ANALYTICS_API_URL=http://127.0.0.1:8787
