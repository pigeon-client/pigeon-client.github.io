{
  "name": "pigeon-monorepo",
  "private": true,
  "version": "0.1.8",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pigeon dev",
    "tauri": "pnpm --filter pigeon tauri",
    "build": "pnpm --filter pigeon build",
    "build:site": "pnpm --filter pigeon-site build",
    "preview:site": "pnpm --filter pigeon-site preview",
    "preview:site:worker": "pnpm --filter pigeon-site preview:worker",
    "deploy:site": "pnpm --filter pigeon-site deploy",
    "test": "pnpm --filter pigeon test",
    "test:watch": "pnpm --filter pigeon test:watch",
    "test:cov": "pnpm --filter pigeon test:cov",
    "test:catalog:check": "pnpm --filter @pigeon/test-catalog check",
    "e2e": "pnpm --filter pigeon e2e",
    "e2e:ui": "pnpm --filter pigeon e2e:ui",
    "check": "biome check",
    "check:write": "biome check --write --unsafe",
    "ci:check": "biome ci --error-on-warnings",
    "check:cycles": "pnpm --filter pigeon check:cycles",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:staged": "biome lint --staged",
    "version:bump": "pnpm --filter pigeon version:bump"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@evilmartians/lefthook": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.16": "^1.1.16",
      "nanoid@<3.3.18": "^3.3.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
